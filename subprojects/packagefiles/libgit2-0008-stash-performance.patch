From 54389bea93097f85d2972fc657454509ce8b6eca Mon Sep 17 00:00:00 2001
From: Alf Henrik Sauge <alf.henrik.sauge@gmail.com>
Date: Fri, 13 Nov 2026 23:36:12 +0100
Subject: [PATCH 2/5] stash: reuse the index tree cache when building the
 workdir tree

The prior code copied the repository index without its cache. This results in
unnecessary rehashing
---
 src/libgit2/stash.c      |  1 +
 src/libgit2/tree-cache.c | 34 ++++++++++++++++++++++++++++++++++
 src/libgit2/tree-cache.h |  1 +
 3 files changed, 36 insertions(+)

diff --git a/src/libgit2/stash.c b/src/libgit2/stash.c
index 788a8ff0d..e24d01774 100644
--- a/src/libgit2/stash.c
+++ b/src/libgit2/stash.c
@@ -491,6 +491,7 @@ static int commit_worktree(
 	if ((error = git_repository_index(&r_index, repo)) < 0 ||
 	    (error = git_index_new_ext(&i_index, &index_opts)) < 0 ||
 	    (error = git_index__fill(i_index, &r_index->entries)) < 0 ||
+	    (error = git_tree_cache_dup(&i_index->tree, r_index->tree, &i_index->tree_pool)) < 0 ||
 	    (error = git_repository__configmap_lookup(&ignorecase, repo, GIT_CONFIGMAP_IGNORECASE)) < 0)
 		goto cleanup;
 
diff --git a/src/libgit2/tree-cache.c b/src/libgit2/tree-cache.c
index f3c895f4c..45c750493 100644
--- a/src/libgit2/tree-cache.c
+++ b/src/libgit2/tree-cache.c
@@ -266,6 +266,40 @@ int git_tree_cache_new(git_tree_cache **out, const char *name, git_oid_t oid_typ
 	return 0;
 }
 
+int git_tree_cache_dup(git_tree_cache **out, const git_tree_cache *src, git_pool *pool)
+{
+	git_tree_cache *tree;
+	size_t i, alloc_size;
+	int error;
+
+	if (src == NULL) {
+		*out = NULL;
+		return 0;
+	}
+
+	if ((error = git_tree_cache_new(&tree, src->name, src->oid_type, pool)) < 0)
+		return error;
+
+	tree->children_count = src->children_count;
+	tree->entry_count = src->entry_count;
+	git_oid_cpy(&tree->oid, &src->oid);
+
+	if (tree->children_count > 0) {
+		GIT_ERROR_CHECK_ALLOC_MULTIPLY(&alloc_size, tree->children_count, sizeof(git_tree_cache *));
+
+		tree->children = git_pool_mallocz(pool, alloc_size);
+		GIT_ERROR_CHECK_ALLOC(tree->children);
+
+		for (i = 0; i < tree->children_count; i++) {
+			if ((error = git_tree_cache_dup(&tree->children[i], src->children[i], pool)) < 0)
+				return error;
+		}
+	}
+
+	*out = tree;
+	return 0;
+}
+
 static void write_tree(git_str *out, git_tree_cache *tree)
 {
 	size_t i;
diff --git a/src/libgit2/tree-cache.h b/src/libgit2/tree-cache.h
index e4a73f277..474aa201a 100644
--- a/src/libgit2/tree-cache.h
+++ b/src/libgit2/tree-cache.h
@@ -31,6 +31,7 @@ int git_tree_cache_read(git_tree_cache **tree, const char *buffer, size_t buffer
 void git_tree_cache_invalidate_path(git_tree_cache *tree, const char *path);
 const git_tree_cache *git_tree_cache_get(const git_tree_cache *tree, const char *path);
 int git_tree_cache_new(git_tree_cache **out, const char *name, git_oid_t oid_type, git_pool *pool);
+int git_tree_cache_dup(git_tree_cache **out, const git_tree_cache *src, git_pool *pool);
 /**
  * Read a tree as the root of the tree cache (like for `git read-tree`)
  */
-- 
