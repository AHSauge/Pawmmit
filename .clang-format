# Base style: LLVM (clang-format 19). The entire config is the project-specific
# deviations below; everything else is clang-format's LLVM defaults. Run
# cl-fmt.sh, which pins the required clang-format version.
BasedOnStyle: LLVM
IndentCaseLabels: true
SortIncludes: Never
StatementAttributeLikeMacros: [Q_EMIT, emit]
---
# .m / .mm files. This document must be present or clang-format refuses to
# format Objective-C sources. Same deviations as the C++ document above.
Language: ObjC
BasedOnStyle: LLVM
IndentCaseLabels: true
SortIncludes: Never
StatementAttributeLikeMacros: [Q_EMIT, emit]
