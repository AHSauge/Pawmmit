# editor/plugins depend back on ui, so they're left out here and resolved at
# the final executable link instead. Scintilla/libgit2/libssh2 are listed
# directly since ui headers include them too, and moc needs to parse those.
ui_deps = [
    pawmmit_common,
    pawmmitUtil_dep,
    conf_dep,
    cred_dep,
    dialogs_dep,
    git_dep,
    host_dep,
    index_dep,
    loglib_dep,
    tools_dep,
    update_dep,
    watcher_dep,
    hunspell_dep,
    libgit2_dep,
    libssh2_dep,
    lexilla_dep,
    scintilla_dep,
    scintillua_dep,
]

ui_moc = qt6.preprocess(
    moc_headers: files(
        'AdvancedSearchWidget.h',
        'BlameEditor.h',
        'BlameMargin.h',
        'ColumnView.h',
        'CommitEditor.h',
        'CommitList.h',
        'CommitToolBar.h',
        'DetailView.h',
        'DiffTreeModel.h',
        'DiffView/DiffView.h',
        'DiffView/EditButton.h',
        'DiffView/FileWidget.h',
        'DiffView/HunkWidget.h',
        'DiffView/Images.h',
        'DoubleTreeWidget.h',
        'EditorWindow.h',
        'ExpandButton.h',
        'FileContextMenu.h',
        'FindWidget.h',
        'Footer.h',
        'History.h',
        'HotkeyManager.h',
        'IgnoreDialog.h',
        'MainWindow.h',
        'MenuBar.h',
        'PathspecWidget.h',
        'ReferenceList.h',
        'ReferenceModel.h',
        'ReferenceView.h',
        'ReferenceWidget.h',
        'RemoteCallbacks.h',
        'RepoView.h',
        'SearchField.h',
        'SideBar.h',
        'StateAction.h',
        'StatePushButton.h',
        'TabBar.h',
        'TabWidget.h',
        'TemplateButton.h',
        'TemplateDialog.h',
        'ToolBar.h',
        'TreeModel.h',
        'TreeProxy.h',
        'TreeView.h',
        'TreeWidget.h',
    ),
    moc_sources: files(
        'ColumnView.cpp',
        'CommitEditor.cpp',
        'CommitList.cpp',
        'DetailView.cpp',
        'IndexCompleter.cpp',
        'ReferenceView.cpp',
        'RepoView.cpp',
        'SearchField.cpp',
        'SideBar.cpp',
        'TabWidget.cpp',
        'ToolBar.cpp',
    ),
    dependencies: ui_deps,
)

ui_src = files(
    'AdvancedSearchWidget.cpp',
    'Badge.cpp',
    'BlameEditor.cpp',
    'BlameMargin.cpp',
    'ColumnView.cpp',
    'CommitList.cpp',
    'CommitToolBar.cpp',
    'CommitEditor.cpp',
    'ContextMenuButton.cpp',
    'DetailView.cpp',
    'DiffView/DiffView.cpp',
    'DiffView/HunkWidget.cpp',
    'DiffView/FileWidget.cpp',
    'DiffView/FileLabel.cpp',
    'DiffView/Images.cpp',
    'DiffView/Comment.cpp',
    'DiffView/EditButton.cpp',
    'DoubleTreeWidget.cpp',
    'EditorWindow.cpp',
    'ExpandButton.cpp',
    'FileContextMenu.cpp',
    'FindWidget.cpp',
    'Footer.cpp',
    'History.cpp',
    'IgnoreDialog.cpp',
    'HotkeyManager.cpp',
    'IndexCompleter.cpp',
    'Location.cpp',
    'MainWindow.cpp',
    'MenuBar.cpp',
    'PathspecWidget.cpp',
    'ProgressIndicator.cpp',
    'ReferenceList.cpp',
    'ReferenceView.cpp',
    'ReferenceModel.cpp',
    'ReferenceWidget.cpp',
    'RepoView.cpp',
    'RemoteCallbacks.cpp',
    'SearchField.cpp',
    'SideBar.cpp',
    'StateAction.cpp',
    'StatePushButton.cpp',
    'SpellChecker.cpp',
    'TabBar.cpp',
    'TabWidget.cpp',
    'TemplateButton.cpp',
    'TemplateDialog.cpp',
    'ToolBar.cpp',
    'TreeModel.cpp',
    'DiffTreeModel.cpp',
    'TreeProxy.cpp',
    'TreeView.cpp',
    'TreeWidget.cpp',
    'ViewDelegate.cpp',
    'ConfigKeys.cpp',
)

ui_lib = static_library(
    'ui',
    ui_src + ui_moc,
    cpp_args: ['-DBUILD_DESCRIPTION="' + build_description + '"'],
    dependencies: ui_deps,
)

ui_dep = declare_dependency(
    link_with: ui_lib,
    include_directories: include_directories('.'),
)
