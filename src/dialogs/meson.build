dialogs_ui = qt6.compile_ui(
    sources: files(
        'AboutDialog.ui',
        'AccountDialog.ui',
        'AddRemoteDialog.ui',
        'AmendDialog.ui',
        'BranchesPanel.ui',
        'CheckoutDialog.ui',
        'CommitDialog.ui',
        'DateSelectionGroupWidget.ui',
        'DiffPanel.ui',
        'EditorPanel.ui',
        'ExternalToolsDialog.ui',
        'GeneralPanel.ui',
        'InfoBox.ui',
        'LfsPanel.ui',
        'LocationPage.ui',
        'MergeDialog.ui',
        'MiscPanel.ui',
        'NewBranchDialog.ui',
        'PullRequestDialog.ui',
        'RemoteDialog.ui',
        'RemotePage.ui',
        'RemotesPanel.ui',
        'RenameBranchDialog.ui',
        'RepoGeneralPanel.ui',
        'SearchPanel.ui',
        'StartDialog.ui',
        'SubmodulesPanel.ui',
        'TagDialog.ui',
        'TerminalPanel.ui',
        'ToolsPanel.ui',
        'UpdatePanel.ui',
        'UpdateSubmodulesDialog.ui',
        'WindowPanel.ui',
    ),
)

dialogs_moc = qt6.preprocess(
    moc_headers: files(
        'AboutDialog.h',
        'AccountDialog.h',
        'AddRemoteDialog.h',
        'AmendDialog.h',
        'BranchDelegate.h',
        'BranchTableModel.h',
        'BranchesPanel.h',
        'CheckoutDialog.h',
        'CloneDialog.h',
        'CommitDialog.h',
        'ConfigDialog.h',
        'DateSelectionGroupWidget.h',
        'DeleteBranchDialog.h',
        'DeleteTagDialog.h',
        'DiffPanel.h',
        'EditorPanel.h',
        'ExternalToolsDialog.h',
        'ExternalToolsModel.h',
        'GeneralPanel.h',
        'InfoBox.h',
        'LfsPanel.h',
        'LocationPage.h',
        'MergeDialog.h',
        'MiscPanel.h',
        'NewBranchDialog.h',
        'PluginsPanel.h',
        'PullRequestDialog.h',
        'RemoteDialog.h',
        'RemotePage.h',
        'RemoteTableModel.h',
        'RemotesPanel.h',
        'RenameBranchDialog.h',
        'RepoGeneralPanel.h',
        'SearchPanel.h',
        'SettingsDialog.h',
        'StartDialog.h',
        'SubmoduleDelegate.h',
        'SubmoduleTableModel.h',
        'SubmodulesPanel.h',
        'TagDialog.h',
        'TerminalPanel.h',
        'ThemeDialog.h',
        'ToolsPanel.h',
        'UpdatePanel.h',
        'UpdateSubmodulesDialog.h',
        'WindowPanel.h',
    ),
    moc_sources: files(
        'CloneDialog.cpp',
        'StartDialog.cpp',
        'ThemeDialog.cpp',
    ),
    # Feed OS defines into moc since meson doesn't set that up for us
    moc_extra_arguments: is_win ? ['-D_WIN32'] : ['-DQ_OS_UNIX'],
    dependencies: [qt6_dep, pawmmit_common],
)

dialogs_src = [
    'AboutDialog.cpp',
    'AccountDialog.cpp',
    'AddRemoteDialog.cpp',
    'AmendDialog.cpp',
    'BranchDelegate.cpp',
    'BranchTableModel.cpp',
    'BranchesPanel.cpp',
    'CheckoutDialog.cpp',
    'CloneDialog.cpp',
    'CommitDialog.cpp',
    'ConfigDialog.cpp',
    'DateSelectionGroupWidget.cpp',
    'DeleteBranchDialog.cpp',
    'DeleteTagDialog.cpp',
    'DiffFileDialog.cpp',
    'DiffPanel.cpp',
    'EditorPanel.cpp',
    'ExternalToolsDialog.cpp',
    'ExternalToolsModel.cpp',
    'GeneralPanel.cpp',
    'HotkeysPanel.cpp',
    'IconLabel.cpp',
    'InfoBox.cpp',
    'LanguageComboBox.cpp',
    'LfsPanel.cpp',
    'LocationPage.cpp',
    'MergeDialog.cpp',
    'MiscPanel.cpp',
    'NewBranchDialog.cpp',
    'PluginsPanel.cpp',
    'PullRequestDialog.cpp',
    'RemoteDialog.cpp',
    'RemotePage.cpp',
    'RemoteTableModel.cpp',
    'RemotesPanel.cpp',
    'RenameBranchDialog.cpp',
    'RepoGeneralPanel.cpp',
    'SearchPanel.cpp',
    'SettingsDialog.cpp',
    'StartDialog.cpp',
    'SubmoduleDelegate.cpp',
    'SubmoduleTableModel.cpp',
    'SubmodulesPanel.cpp',
    'TagDialog.cpp',
    'TerminalPanel.cpp',
    'ThemeDialog.cpp',
    'ToolsPanel.cpp',
    'UpdatePanel.cpp',
    'UpdateSubmodulesDialog.cpp',
    'WindowPanel.cpp',
]

dialogs_lib = static_library(
    'dialogs',
    dialogs_src + dialogs_moc + dialogs_ui,
    dependencies: [
        pawmmit_common,
        version_dep,
        translation_dep,
        cli_dep,
        conf_dep,
        cred_dep,
        host_dep,
        index_dep,
    ])

dialogs_dep = declare_dependency(
    link_with: dialogs_lib,
    include_directories: include_directories('.'),
)
